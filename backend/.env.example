# --- Banco (Neon) -----------------------------------------------------------------------
# `neon env pull` / `neon deploy` grava as duas na raiz do projeto, em .env.local.
# Pooled (host com "-pooler"): tráfego normal da aplicação.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Direta (sem "-pooler"): usada só para criar/ajustar as tabelas na subida. Opcional fora do Neon.
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Segurança --------------------------------------------------------------------------
# Segredo que assina os logins. Invente uma frase longa e aleatória (e nunca a publique).
JWT_SECRET=troque-isso-por-um-segredo-aleatorio-longo
# Sites autorizados a chamar a API pelo navegador (separe por vírgula; sem barra no final).
# Vazio ou * = aberto (ok em desenvolvimento). Em produção: a URL exata do site na Vercel.
CORS_ORIGIN=http://localhost:5173

PORT=4000
